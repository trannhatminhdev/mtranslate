{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri/tauri-v2/tooling/cli/schema.json",
  "productName": "MTrans",
  "version": "0.1.0",
  "identifier": "com.mtrans.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "MTrans - AI Voice Translation",
        "width": 900,
        "height": 640,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
